# ---- Core ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./orgbrain.db
# For Postgres (Neon/Supabase), use something like:
# DATABASE_URL=postgresql://user:password@host/dbname

# ---- LLM Provider ----
# Options: groq | huggingface | gemini
LLM_PROVIDER=groq

# Groq (get a free key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Hugging Face Inference (get a free token at https://huggingface.co/settings/tokens)
# Works with IBM Granite models e.g. ibm-granite/granite-3.1-8b-instruct
HF_API_KEY=your_huggingface_key_here
HF_MODEL=ibm-granite/granite-3.1-8b-instruct

# Gemini (optional fallback, get a free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# ---- Vector DB (ChromaDB, runs embedded, no key needed) ----
CHROMA_PERSIST_DIR=./chroma_data

# ---- Graph DB (optional - app runs fine without this set) ----
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---- CORS ----
FRONTEND_ORIGIN=http://localhost:3000
